# Generar con: openssl rand -hex 32
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=stock.luiscontacto03.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://stock.luiscontacto03.com

# Ruta del fichero SQLite dentro del volumen montado (ver docker-compose.server.yml)
DJANGO_DB_PATH=/app/db/db.sqlite3

# Solo para el comando manage.py import_exclusion_rules (se ejecuta una vez a mano,
# no en marcha). GOOGLE_SHEET_TAB confirmado: "Hoja 2" (Hoja 1 tiene la cabecera
# corrupta, no se usa).
GOOGLE_SHEET_ID=1nzO_kGbkPnY8xi_OvglGTCl6kh83DMi8CZnLr-v-ru4
GOOGLE_SHEET_TAB=Hoja 2

# Solo para el comando manage.py import_supplier_categories (una vez a mano).
# Tienen valor por defecto en el propio comando; solo hace falta tocarlos si
# cambia la hoja de Google Sheets.
# SUPPLIER_CATEGORY_SHEET_ID=1SG_zmnza0Jgp_Jb3v6uyTGpjjKM0mz7kxeDKNfCSkq0
# SUPPLIER_CATEGORY_SHEET_TAB=Hoja 1

# ── Publicación bajo spsil.luiscontacto03.com/stock (plataforma SPSIL) ──
# Ruta pública: el portal quita el prefijo al entrar y la app lo pone en sus
# enlaces. Vacía = la app en la raíz de su dominio (stock.luiscontacto03.com).
# DJANGO_ALLOWED_HOSTS debe incluir spsil.luiscontacto03.com y
# DJANGO_CSRF_TRUSTED_ORIGINS https://spsil.luiscontacto03.com
DJANGO_RUTA_BASE=
APP_URL_PUBLICA=

# Login: local (usuarios de /admin/) o sso (Keycloak, el mismo realm que el
# Gestor de Tareas: entrar en una app vale para la otra). Ver core/sso.py.
AUTH_MODO=local
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
# Keycloak -> realm spsil -> Clients -> app-stock -> Credentials. No lo pegues en chats.
KEYCLOAK_CLIENT_SECRET=
# A dónde volver al cerrar sesión (la portada), p. ej. https://spsil.luiscontacto03.com/
SSO_URL_SALIDA=
