# ============================================================================
#  Agente de datos SPSIL (equipo X) — punto de consulta hacia las bases de datos
#  Copia este fichero como .env junto a docker-compose.yml y rellénalo.
#  Si cambia el punto de acceso a la red (otra IP, otra VPN, otra copia de la
#  BD), solo hay que tocar este fichero y reiniciar: docker compose up -d
#  NO subas el .env a ningún sitio.
# ============================================================================

# --- Túnel hacia el portal (servidor Y) -------------------------------------
# Déjalo vacío para probar solo en local con la API local (LOCAL_API_PORT).
GATEWAY_URL=wss://spsil.luiscontacto03.com/stock/ws/gateway/nave-central/
NODE_TOKEN=cambia-esto-por-el-token-mostrado-una-vez-en-el-admin

# --- A3 ERP (SQL Server) ---------------------------------------------------
A3_HOST=192.168.10.209
A3_PORT=1433
A3_DATABASE=SG
A3_USER=cambia-esto
A3_PASSWORD=cambia-esto

# --- Innertia (MariaDB, almacén) -------------------------------------------
INNERTIA_HOST=192.168.10.215
INNERTIA_PORT=3306
INNERTIA_DATABASE=almacenmultiforte
INNERTIA_USER=cambia-esto
INNERTIA_PASSWORD=cambia-esto
# Ubicación por defecto si el portal no manda ninguna (Configuración > Ubicaciones)
ID_CENTRO=6
ID_ALMACEN=1
ID_ZONA=1

# (Los nombres antiguos MSSQL_* y MARIADB_* siguen funcionando si ya los tenías.)

# --- Hojas de Google --------------------------------------------------------
# Cada hoja se puede cambiar por otro id o por una URL CSV completa
# ("Archivo > Compartir > Publicar en la web > CSV"). Vacío = la de siempre.
# La pestaña se cambia con GSHEET_<CLAVE>_HOJA.
# GSHEET_COMERCIALES=1tMpaWqwIWnRkNIMQ_b9S-JF6mmP6aDbhoSGbBOOYR_w
# GSHEET_FILTRO_COBROS=1V5QszuvHhPp3spdKrU5nrM1wpq-d3ndHUL7CxF-80jQ
# GSHEET_EXPEDICIONES=1cKQ-M82GseLK_El-i45kwtl6E1IXPij7fjnzWbBQNa4
# GSHEET_COBRO_TRANSPORTE=1jgta_zXrBTa8acCD7pDf3z3KF_5a8D3bY04NLVURcJc
# GSHEET_PRECIOS_TRANSPORTE=1Rh7a6w9rkRg9xl9hlGarkCG1fk38lcyiDqx_sAhAduY
# GSHEET_VENTAS_WEB=1w5GoGyE098DOaYtiKY2B1JWj6uakkCJLVQvwr9tacNo
# GSHEET_ZONA_COM=1DqrjyDvu6mEqwzlN8pgLw-KYSzGNQO6mwIGpmz1jBIw
# GSHEET_VOLUMEN_PACKAGING=1xHBpxIURY2BO8MsSc7qGoij1sfvH6CjpVHhKWL-M1iw
# GSHEET_PASILLOS=1NGDCONR9REnYEekEh2ctMWiVYP-DQ8QGUBBVgxZdMHE
# GSHEET_CATEGORIA_PROVEEDORES=1SG_zmnza0Jgp_Jb3v6uyTGpjjKM0mz7kxeDKNfCSkq0

# --- Informes ---------------------------------------------------------------
# Cada consulta se guarda en memoria este tiempo antes de volver a la BD.
INFORMES_CACHE_SEGUNDOS=300
# Años hacia atrás que cargan los informes de ventas/pedidos/facturas.
INFORMES_ANIOS_HISTORICO=2
# Stock Tabla (ya existente)
STOCK_RAW_REFRESH_SECONDS=600
STOCK_TABLA_REFRESH_SECONDS=15

# --- API local de prueba (solo en este equipo, 127.0.0.1) -------------------
# http://127.0.0.1:8765/salud  /origenes  /datasets  /datasets/<nombre>
LOCAL_API_PORT=8765
# Opcional: exige ?token=... o "Authorization: Bearer ..."
LOCAL_API_TOKEN=

# --- Proxy de bases de datos (opcional, perfil "proxy-bd") -------------------
# docker compose --profile proxy-bd up -d
# Publica en este equipo un punto fijo hacia el SQL Server y el MariaDB de
# arriba, para que Power BI (u otras herramientas) apunten aquí y no a la IP
# real: si la IP cambia, solo se toca este .env. Por defecto solo localhost;
# pon PROXY_BIND=0.0.0.0 si otros equipos de la red tienen que usarlo.
PROXY_BIND=127.0.0.1
PROXY_PUERTO_A3=1433
PROXY_PUERTO_INNERTIA=3306
